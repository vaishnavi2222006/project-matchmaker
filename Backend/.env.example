# ─────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# GitHub OAuth — get from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# JWT — generate a random 64-char string: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRE=7d

# Supabase — get from https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini AI — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ─── PRODUCTION OVERRIDES (set in Render dashboard) ───────────────
# GITHUB_CALLBACK_URL=https://your-backend.onrender.com/auth/github/callback
# FRONTEND_URL=https://your-frontend.vercel.app
# CLIENT_URL=https://your-frontend.vercel.app
# NODE_ENV=production
# PORT=10000
