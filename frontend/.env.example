# ─────────────────────────────────────────────
# Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# Only VITE_ prefixed vars are available in the browser
# ─────────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:5000

# App metadata
VITE_APP_NAME=Open Source Matchmaker
VITE_ENABLE_API_DISCOVERY=true

# GitHub OAuth Client ID (safe to expose — it's public)
# Get from https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ─── PRODUCTION OVERRIDES (set in Vercel dashboard) ───────────────
# VITE_API_URL=https://your-backend.onrender.com
